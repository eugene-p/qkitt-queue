{
  "name": "@qkitt/queue-bench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local throughput and retained-memory regression for @qkitt/queue",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bench": "tsx --expose-gc src/index.ts",
    "bench:worker": "tsx --expose-gc src/index.ts worker",
    "bench:payload": "tsx --expose-gc src/index.ts payload",
    "bench:durable": "tsx --expose-gc src/index.ts durable",
    "bench:workloads": "tsx --expose-gc src/index.ts workloads",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@qkitt/queue": "file:../queue",
    "async": "^3.2.6",
    "fastq": "^1.19.1",
    "p-queue": "^8.1.0",
    "tinybench": "^4.0.1"
  },
  "devDependencies": {
    "@types/async": "^3.2.24",
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2"
  }
}
